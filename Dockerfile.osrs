# syntax=docker/dockerfile:1
# QUIPU Old School RuneScape (OSRS) Game Client Container

FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    OSRS_PORT=7310 \
    OSRS_HOST=0.0.0.0 \
    OSRS_DIR=/games/osrs

# Install system dependencies (Java JRE for RuneLite, curl, xvfb for headless display)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    default-jre-headless \
    xvfb \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
RUN mkdir -p /games/osrs
VOLUME /games/osrs

EXPOSE 7310

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request,sys;sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:7310/health',timeout=4).status==200 else 1)"

CMD ["python", "-m", "quipu.games.osrs_client_daemon"]
