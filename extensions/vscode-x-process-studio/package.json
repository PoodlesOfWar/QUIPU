{
  "name": "x-process-studio",
  "displayName": "x_ProcessStudio (QUIPU)",
  "description": "Gives VS Code agents the QUIPU x_ProcessStudio holon as an MCP server: inspect the action ledger, list Activepieces tools, and stage governed action proposals for the operator to authorise.",
  "version": "0.1.0",
  "publisher": "poodlesofwar",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/PoodlesOfWar/QUIPU.git",
    "directory": "extensions/vscode-x-process-studio"
  },
  "homepage": "https://github.com/PoodlesOfWar/QUIPU/blob/main/docs/X_PROCESS_STUDIO.md",
  "bugs": {
    "url": "https://github.com/PoodlesOfWar/QUIPU/issues"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "mcp",
    "activepieces",
    "agent",
    "quipu",
    "automation"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "quipu.x-process-studio",
        "label": "x_ProcessStudio (QUIPU)"
      }
    ],
    "configuration": {
      "title": "x_ProcessStudio",
      "properties": {
        "xProcessStudio.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:7110/mcp",
          "markdownDescription": "URL of the QUIPU `quipu-mcp` server (Streamable HTTP). Use `https://` for anything off this machine."
        },
        "xProcessStudio.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Offer the x_ProcessStudio MCP server to agents."
        }
      }
    },
    "commands": [
      {
        "command": "xProcessStudio.setToken",
        "title": "Set Server Token",
        "category": "x_ProcessStudio"
      },
      {
        "command": "xProcessStudio.clearToken",
        "title": "Clear Server Token",
        "category": "x_ProcessStudio"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies --skip-license",
    "publish:vsce": "vsce publish --no-dependencies --skip-license",
    "publish:ovsx": "ovsx publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "^3.2.0",
    "ovsx": "^0.10.0",
    "typescript": "^5.4.0"
  }
}
