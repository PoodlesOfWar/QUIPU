# syntax=docker/dockerfile:1
# QUIPU Continuous Video & Stream Gameplay Trainer Container

FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    SCB_DB_PATH=/data/local_brain.sqlite \
    TRAINER_PORT=7250 \
    TRAINER_HOST=0.0.0.0 \
    RECORDINGS_DIR=/app/recordings \
    QUIPU_ARTIFACT_DIR=/app/quipu_learned_artifacts

# Install dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
RUN mkdir -p /data /app/quipu_learned_artifacts /app/recordings
VOLUME /app/recordings
VOLUME /app/quipu_learned_artifacts

EXPOSE 7250

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request,sys;sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:7250/status',timeout=4).status==200 else 1)"

CMD ["python", "-m", "quipu.video_trainer_daemon"]
