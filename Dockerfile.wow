# syntax=docker/dockerfile:1
# QUIPU World of Warcraft (WoW) Game Client Container

FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    WOW_PORT=7320 \
    WOW_HOST=0.0.0.0 \
    WOW_DIR=/games/wow

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    unzip \
    xvfb \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
RUN mkdir -p /games/wow
VOLUME /games/wow

EXPOSE 7320

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request,sys;sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:7320/health',timeout=4).status==200 else 1)"

CMD ["python", "-m", "quipu.games.wow_client_daemon"]
