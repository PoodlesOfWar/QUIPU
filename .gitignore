# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Runtime state (recreated locally; never commit)
bridge_state/
*.sqlite
*.sqlite3
*sqlite-shm
*sqlite-wal
*.db
*.bak
*.log
logs/

# Auto-forged tools (regenerated locally by tool_forge; not source)
src/quipu/tools/generated/

# Secrets
.env
*.env
secrets.json

# Julia
julia/Manifest.toml

# OS / IDE
.DS_Store
Thumbs.db
.idea/

# GARD Shard temp artifacts
gui/GARD_Shard/compression/*
!gui/GARD_Shard/compression/.gitkeep
gui/GARD_Shard/decompression/*
!gui/GARD_Shard/decompression/.gitkeep


# GARD Lite runtime output (sealed containers and restored payloads are user
