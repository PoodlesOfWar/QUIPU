# syntax=docker/dockerfile:1
# QUIPU Guild Wars 1 (GW) Game Client Container

FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    GW_PORT=7330 \
    GW_HOST=0.0.0.0 \
    GW_DIR=/games/gw

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    xvfb \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
RUN mkdir -p /games/gw
VOLUME /games/gw

EXPOSE 7330

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request,sys;sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:7330/health',timeout=4).status==200 else 1)"

CMD ["python", "-m", "quipu.games.gw_client_daemon"]
