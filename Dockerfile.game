# syntax=docker/dockerfile:1
# QUIPU Game Mesh & Video Pipeline Autonomous Agent Container

FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    SCB_DB_PATH=/data/local_brain.sqlite \
    GAME_PIPELINE_PORT=7200 \
    GAME_PIPELINE_HOST=0.0.0.0

# Install dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
RUN mkdir -p /data /app/quipu_learned_artifacts
VOLUME /data

EXPOSE 7200

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request,sys;sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:7200/health',timeout=4).status==200 else 1)"

CMD ["python", "-m", "quipu.game_pipeline_service"]
